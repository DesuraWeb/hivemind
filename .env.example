# --- Base de données ---
DATABASE_URL=postgres://desura@localhost:5432/silithid
DATABASE_URL_TEST=postgres://desura@localhost:5432/silithid_test

# --- Serveur ---
PORT=3000
NODE_ENV=development

# --- Secrets (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
# Interface d'ecoute. 127.0.0.1 par defaut : derriere un reverse proxy, exposer
# le port applicatif permettrait de contourner nginx, son TLS et son auth.
# Un conteneur pose HOST=0.0.0.0 explicitement.
HOST=127.0.0.1
MASTER_KEY=REMPLACER_32_OCTETS_BASE64
SESSION_SECRET=REMPLACER_32_OCTETS_BASE64

# --- Agents (RUNTIME_ADAPTER : claude | fake) ---
RUNTIME_ADAPTER=claude
WORKTREES_ROOT=./worktrees
ARTIFACTS_ROOT=./artifacts
# Chromium du systeme, quand celui de Playwright ne peut pas se telecharger
# (le bucket Chrome for Testing de Google refuse certaines IP selon leur pays).
# Vide = comportement habituel. Exemple : /usr/bin/chromium
CHROMIUM_EXECUTABLE_PATH=
# Boucles simultanees sur cette machine. Trois tient sur 8 Go de RAM libre
# (~285 Mo par agent). Sans swap, depasser la RAM ne ralentit pas : l'OOM
# killer tue un process au hasard. Monter ce chiffre demande d'abord du swap.
LOOP_CONCURRENCY=3

# --- Mode dev : rien ne part vers l'extérieur ---
MAIL_DRY_RUN=1
PROD_DISPATCH_DRY_RUN=1

# --- SMTP (alertes critiques uniquement) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=alerts@exemple.test
ALERT_EMAIL_FROM=silithid@silithid.com
